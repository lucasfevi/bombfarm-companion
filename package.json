{
  "name": "bombfarm-companion",
  "private": true,
  "description": "Bomb Farm Companion — desktop companion app",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @bombfarm/desktop dev",
    "dev:offline": "pnpm --filter @bombfarm/desktop dev:offline",
    "dev:web": "pnpm --filter @bombfarm/web dev",
    "build": "node tools/with-cpu-budget.mjs pnpm -r build",
    "typecheck": "node tools/with-cpu-budget.mjs pnpm -r typecheck",
    "lint": "node tools/with-cpu-budget.mjs pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "pnpm --filter @bombfarm/desktop test:smoke",
    "generate:wire-vocabulary": "node tools/generate-wire-glossary.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.31.0",
    "@manypkg/get-packages": "^1.1.3",
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.16.5",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "semver": "^7.8.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp",
      "better-sqlite3",
      "frida"
    ]
  }
}
