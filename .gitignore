node_modules/
dist/
/packages/tap-runtime/src/script-source.js
out/
.next/
# `next dev` writes here instead of `.next` so a concurrent `next build` cannot wipe the
# manifests the running dev server holds open — see apps/web/next.config.ts.
.next-dev/
# Generated by whichever Next command ran last, and its `routes.d.ts` reference points at that
# command's dist directory — so a tracked copy flips between `.next` and `.next-dev` forever.
next-env.d.ts
.pnpm-store/
*.log
coverage/
.turbo/
*.tsbuildinfo
.DS_Store
Thumbs.db
/release/
# electron-builder's output. Rooted `/release/` above never covered it, so a stray `git add -A`
# in apps/desktop stages a ~350MB installer and unpacked app.
apps/desktop/release/
playwright-report/
test-results/
storybook-static/
.env
.env.*
.specs/

# @bombfarm/game-art's assets, copied in by each app's prebuild step
# (apps/*/scripts/copy-wiki-assets.mjs) — the package under packages/game-art/assets is the
# tracked copy.
/apps/web/public/wiki-assets/
/apps/desktop/renderer/public/wiki-assets/

# Local agent dev-server config — ports and commands are per-machine.
.claude/launch.json

# Private agent context. THIS REPO IS PUBLIC — anything describing the wider
# workspace belongs in CLAUDE.local.md, which stays local and is never committed.
CLAUDE.local.md
*.local.md

# Release-rail scratch output (generated by .github/workflows/release-pr.yml).
# Rooted so tools/release/__fixtures__/release-plan-*.json stay tracked.
/release-plan.json
/release-metadata.json
/release-pr-body.md

# `pnpm dev:offline` keeps its account database here, out of the shared dev profile.
.offline-user-data/
