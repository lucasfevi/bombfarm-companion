shamefully-hoist=true
only-built-dependencies[]=better-sqlite3
only-built-dependencies[]=electron

# Cap how many workspace scripts `pnpm -r` runs at once (`pnpm typecheck`, `pnpm lint`,
# `pnpm build` are all `pnpm -r`). Left unset, this takes pnpm's built-in default, which
# varies by pnpm version — pinning it makes local and CI behave the same way on purpose.
#
# Each workspace's `lint` and `typecheck` is a whole TypeScript program, not a thread:
# eslint.config.mjs enables `projectService: true`, so every concurrent `eslint src` builds
# and holds its own type information alongside the concurrent `tsc --noEmit` runs. Peak
# memory and CPU scale with this number far more steeply than wall time falls.
#
# Same reasoning as the Vitest cap in `vitest.workers.ts` and the Next/Playwright caps in
# `apps/web`: bound the machine's load rather than let each tool scale to core count
# independently and multiply.
#
# This is the CEILING, not the whole story, and it is read back by `tools/with-cpu-budget.mjs`
# so the number lives in exactly one place. `pnpm build`, `pnpm typecheck` and `pnpm lint` go
# through that wrapper, which lowers this further while other Bomb Farm runs are executing —
# a cap in a config file bounds one run, and several runs at once each took it whole. A bare
# `pnpm -r` typed by hand does not get that and stops here, which is why the static value has
# to stay conservative on its own. See `docs/machine-load.md`.
workspace-concurrency=2
