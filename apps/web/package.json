{
  "name": "@bombfarm/web",
  "version": "0.10.0",
  "private": true,
  "sideEffects": [
    "src/features/team-plan/index.ts",
    "src/features/team-plan/worker/register-chunk.ts"
  ],
  "description": "Bomb Farm Companion web planner (static Next export)",
  "scripts": {
    "predev": "node scripts/copy-wiki-assets.mjs",
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "prebuild": "node scripts/copy-wiki-assets.mjs && pnpm --filter @bombfarm/contracts --filter @bombfarm/pricing build",
    "build": "next build",
    "prebuild:e2e": "node scripts/copy-wiki-assets.mjs && pnpm --filter @bombfarm/contracts --filter @bombfarm/pricing build",
    "build:e2e": "cross-env BFC_VERSION_LABEL_OVERRIDE=v0.0.0-e2e next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/scripts/docker-run.mjs test",
    "test:e2e:smoke": "node e2e/scripts/docker-run.mjs smoke",
    "test:e2e:visual": "node e2e/scripts/docker-run.mjs visual",
    "test:e2e:host": "playwright test",
    "test:e2e:host:smoke": "playwright test --project=smoke",
    "perf:capture": "node e2e/scripts/docker-run.mjs perf",
    "perf:host": "node e2e/scripts/perf-host.mjs",
    "perf:build:profile": "node e2e/scripts/perf-build-profile.mjs",
    "perf:capture:profile": "node e2e/scripts/perf-profile-host.mjs",
    "perf:compare": "node e2e/scripts/perf-compare-baseline.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@bombfarm/domain": "workspace:*",
    "@bombfarm/farm": "workspace:*",
    "@bombfarm/game-art": "workspace:*",
    "@bombfarm/pricing": "workspace:*",
    "@bombfarm/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@microsoft/clarity": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.42.2",
    "next": "^15.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "eslint-import-resolver-typescript": "3.6.3",
    "eslint-plugin-boundaries": "7.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-unicorn": "62.0.0",
    "globals": "^16.3.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "webpack": "5.98.0"
  }
}
