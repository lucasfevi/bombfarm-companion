{
  "name": "@bombfarm/domain",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gear": {
      "types": "./dist/gear/index.d.ts",
      "import": "./dist/gear/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js"
    },
    "./stat-breakdown": {
      "types": "./dist/stat-breakdown/index.d.ts",
      "import": "./dist/stat-breakdown/index.js"
    },
    "./team-plan": {
      "types": "./dist/team-plan/index.d.ts",
      "import": "./dist/team-plan/index.js"
    },
    "./data/*": "./dist/data/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@bombfarm/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
