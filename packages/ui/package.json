  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "serve-storybook": "http-server storybook-static --port 6006 --silent",
    "test-storybook": "concurrently -k -s first -n \"SB,TEST\" \"pnpm serve-storybook\" \"wait-on tcp:6006 && test-storybook --url http://127.0.0.1:6006 --maxWorkers=2\""
  },
